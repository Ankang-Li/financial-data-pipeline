# Copy to .env and fill in. Never commit a real key.
# All variables are optional: the offline demo and the test suite run without them.

# FRED API key, free from https://fred.stlouisfed.org/docs/api/api_key.html
# Required only for `--mode live` ingestion of macro series from FRED.
FDP_FRED_API_KEY=

# Override the data root (raw / normalized / quarantine / warehouse live here).
# Defaults to <repo>/data
FDP_DATA_DIR=

# HTTP behaviour for live ingestion
FDP_HTTP_TIMEOUT=30
FDP_MAX_RETRIES=3

# Validation thresholds
# Max tolerated absolute difference between two sources for the same yield series, in bp
FDP_CROSS_SOURCE_TOLERANCE_BP=5
# Share of missing values in a required column above which the issue is an ERROR
FDP_MISSING_RATIO_ERROR=0.05
# Absolute daily log return above which a price move is flagged for review
FDP_EXTREME_RETURN_THRESHOLD=0.25
